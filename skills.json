{
  "name": "my-ai-skills",
  "version": "1.0.0",
  "description": "Personal AI skills library for agents, coding assistants, and automation tools.",
  "default_language": "zh-TW",
  "maintainer": {
    "name": "YOUR_NAME",
    "github": "https://github.com/YOUR_USERNAME"
  },
  "compatibility": {
    "markdown": true,
    "openapi": true,
    "mcp": true,
    "cli_scripts": true
  },
  "skills": [
    {
      "id": "data_analysis",
      "name": "Data Analysis",
      "visibility": "private",
      "type": "cli",
      "description": "Analyze CSV or Excel files and generate Markdown reports.",
      "location": "custom_skills/data_analysis/",
      "entrypoint": "custom_skills/data_analysis/run.py",
      "instruction_file": "custom_skills/data_analysis/SKILL.md",
      "manifest": "custom_skills/data_analysis/manifest.json",
      "runtime": "python",
      "command": "python custom_skills/data_analysis/run.py --input {{input_file}} --output {{output_file}}",
      "inputs": [
        {
          "name": "input_file",
          "type": "file",
          "required": true,
          "description": "CSV or Excel file to analyze."
        },
        {
          "name": "output_file",
          "type": "string",
          "required": true,
          "description": "Markdown report output path."
        }
      ],
      "outputs": [
        {
          "name": "report",
          "type": "markdown"
        }
      ],
      "permissions": {
        "filesystem_read": true,
        "filesystem_write": true,
        "network": false
      },
      "risk_level": "medium",
      "tags": [
        "data",
        "csv",
        "excel",
        "report"
      ]
    },
    {
      "id": "to_prd",
      "name": "To PRD",
      "visibility": "private",
      "type": "instruction",
      "description": "Synthesize conversation and codebase context into a structured PRD in Markdown.",
      "location": "custom_skills/to_prd/",
      "instruction_file": "custom_skills/to_prd/SKILL.md",
      "manifest": "custom_skills/to_prd/manifest.json",
      "runtime": "instruction_only",
      "inputs": [
        {
          "name": "conversation_context",
          "type": "text",
          "required": true,
          "description": "User goal, prior discussion, or decision context."
        },
        {
          "name": "codebase_context",
          "type": "files_or_directory",
          "required": false,
          "description": "Relevant repository context when the PRD depends on existing implementation."
        },
        {
          "name": "output_file",
          "type": "string",
          "required": false,
          "description": "Optional Markdown output path for the generated PRD."
        }
      ],
      "outputs": [
        {
          "name": "prd",
          "type": "markdown"
        }
      ],
      "permissions": {
        "filesystem_read": true,
        "filesystem_write": true,
        "network": false
      },
      "risk_level": "low",
      "tags": [
        "prd",
        "spec",
        "documentation",
        "planning"
      ]
    },
    {
      "id": "write_a_skill",
      "name": "Write a Skill",
      "visibility": "private",
      "type": "instruction",
      "description": "Create a new agent skill with structure, trigger guidance, and supporting resources.",
      "location": "custom_skills/write_a_skill/",
      "instruction_file": "custom_skills/write_a_skill/SKILL.md",
      "manifest": "custom_skills/write_a_skill/manifest.json",
      "runtime": "instruction_only",
      "inputs": [
        {
          "name": "task_description",
          "type": "text",
          "required": true,
          "description": "What the new skill should help an agent do."
        },
        {
          "name": "usage_examples",
          "type": "text",
          "required": false,
          "description": "Optional examples, keywords, or triggering phrases."
        }
      ],
      "outputs": [
        {
          "name": "skill_bundle",
          "type": "markdown_and_metadata"
        }
      ],
      "permissions": {
        "filesystem_read": true,
        "filesystem_write": true,
        "network": false
      },
      "risk_level": "low",
      "tags": [
        "skill-authoring",
        "agents",
        "metadata",
        "workflow"
      ]
    },
    {
      "id": "lovable_github_cloudflare_worker",
      "name": "Lovable GitHub Cloudflare Worker",
      "visibility": "private",
      "type": "workflow",
      "description": "Stabilize a Lovable-generated project into a GitHub-managed and Cloudflare Worker-ready delivery pipeline.",
      "location": "custom_skills/lovable_github_cloudflare_worker/",
      "instruction_file": "custom_skills/lovable_github_cloudflare_worker/SKILL.md",
      "manifest": "custom_skills/lovable_github_cloudflare_worker/manifest.json",
      "runtime": "instruction_only",
      "inputs": [
        {
          "name": "project_path",
          "type": "string",
          "required": true,
          "description": "Local path to the Lovable-generated project."
        },
        {
          "name": "github_repo",
          "type": "string",
          "required": false,
          "description": "Target GitHub repository URL or identifier."
        },
        {
          "name": "cloudflare_target",
          "type": "text",
          "required": false,
          "description": "Worker name, routes, bindings, and deployment constraints."
        }
      ],
      "outputs": [
        {
          "name": "delivery_report",
          "type": "markdown"
        }
      ],
      "permissions": {
        "filesystem_read": true,
        "filesystem_write": true,
        "network": true
      },
      "risk_level": "high",
      "tags": [
        "lovable",
        "github",
        "cloudflare",
        "worker",
        "deployment"
      ]
    },
