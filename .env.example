# Copy this file to .env for local-only configuration.
# Never commit a populated .env file or paste credentials into public issues.
# The bundled data-analysis CLI does not require any of these variables.

# Optional weather provider credentials for a local integration that you build.
OPENWEATHER_API_KEY=

# Optional Notion integration credentials; no Notion client is bundled here.
NOTION_API_KEY=

# Optional GitHub token for local scripts; prefer the minimum required scope.
GITHUB_TOKEN=

# Optional custom API endpoint for a local adapter.
CUSTOM_API_BASE_URL=
