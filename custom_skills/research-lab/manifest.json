{
  "id": "research-lab",
  "name": "research-lab — AI 研究實驗室",
  "version": "1.0.0",
  "license": "MIT",
  "category": "Research / Decision Intelligence",
  "capability": "research-lab",
  "description": "Break complex research, investigation, market analysis, product analysis, competitor analysis, technical trend research, business model analysis, growth strategy, SEO/GEO, education, AI, or tutoring topics into verifiable breadth scans, depth dives, cross-validation, and decision-ready reports.",
  "entrypoint": "SKILL.md",
  "runtime": "instruction_only",
  "language": "zh-TW",
  "inputs": {
    "research_topic": {
      "type": "text",
      "required": true,
      "description": "Research topic, keyword, market, product, strategy, technology, or decision question."
    },
    "mode": {
      "type": "string",
      "required": false,
      "description": "full, breadth_only, depth_only, or quick. Defaults to full when not specified."
    },
    "decision_context": {
      "type": "text",
      "required": false,
      "description": "Decision use case, constraints, time range, geography, industry scope, and required depth."
    },
    "source_materials": {
      "type": "files_or_urls_or_text",
      "required": false,
      "description": "Optional documents, links, notes, competitor names, data, or prior research."
    }
  },
  "outputs": {
    "breadth_scan": {
      "type": "markdown"
    },
    "depth_research": {
      "type": "markdown"
    },
    "decision_report": {
      "type": "markdown"
    },
    "next_research_questions": {
      "type": "markdown"
    }
  },
  "permissions": {
    "filesystem_read": true,
    "filesystem_write": true,
    "network": true
  },
  "safety": {
    "handles_sensitive_data": false,
    "requires_user_confirmation": false,
    "destructive": false,
    "rules": [
      "Tie each subtask back to the original research topic.",
      "Mark uncertainty and confidence for risky conclusions.",
      "Separate facts, inferences, and recommendations.",
      "Do not invent sources, evidence, or statistics."
    ],
    "stop_conditions": [
      "授權、資料來源、範圍、身份或外部操作權限無法確認時停止高影響部分。",
      "發現來源矛盾、敏感資料暴露、輸出無法驗證或任務目標漂移時停止並要求人工判斷。"
    ],
    "approval_scope": [
      "exact_action",
      "exact_target",
      "exact_diff",
      "rollback_or_recovery_plan"
    ],
    "audit_requirements": [
      "record_sources",
      "record_assumptions",
      "record_approval_before_write"
    ],
    "rollback_required": false,
    "dry_run_default": true,
    "data_minimization": "redact_by_default"
  },
  "risk_level": "medium",
  "default_config": {
    "mode": "full",
    "breadth_dimensions_min": 4,
    "breadth_dimensions_max": 12,
    "depth_levels": [
      "L0_overview",
      "L1_subquestions",
      "L2_evidence_cases",
      "L3_actionable_conclusions"
    ],
    "output_style": "decision_ready_report",
    "separate_facts_inferences_recommendations": true,
    "mark_uncertainty": true
  },
  "activation_policy": "use_for_complex_research_and_decision_reports",
  "tags": [
    "research",
    "market-research",
    "product-research",
    "competitor-analysis",
    "technical-trends",
    "business-model",
    "growth-strategy",
    "seo",
    "geo",
    "education",
    "ai",
    "decision-report"
  ],
  "schema_version": "1.1.0",
  "contract_version": "1.1.0",
  "capabilities": {
    "filesystem": "workspace_read_write",
    "network": "public_read_only",
    "shell": "none",
    "git": "none",
    "browser": "none"
  },
  "connectors": [],
  "data_egress": {
    "mode": "public_data_only",
    "connectors": [],
    "allowed_data_classes": [
      "public_data"
    ],
    "approval_required": false,
    "minimize_and_redact": true,
    "retention": "none_by_default"
  },
  "external_write": {
    "allowed": false,
    "mode": "draft_or_read_only",
    "approval_required": true,
    "approval_scope": []
  },
  "execution": {
    "executor": "instruction_only",
    "adapter": "SKILL.md",
    "network_is_not_implied": true
  },
  "activation": {
    "positive_examples": [
      "進行資料蒐集、來源查證、研究整理或研究報告產出。"
    ],
    "negative_examples": [
      "只需要研究方法、實驗假設或研究團隊治理設計。"
    ],
    "exclude_when": [
      "若主要任務是設計實驗方法而非交付研究結果，交由 ai-research-lab。"
    ],
    "priority": 60,
    "delegates_to": [],
    "selection_notes": "先檢查任務目的、輸入資料與外部權限；相鄰技能重疊時以最小權限與最窄範圍優先。"
  },
  "related_skills": [
    "ai-research-lab",
    "marketing-brief-competitor-analyst"
  ]
}
