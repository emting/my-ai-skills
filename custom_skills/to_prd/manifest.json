{
  "id": "to_prd",
  "name": "To PRD",
  "version": "1.0.0",
  "description": "Turn conversation and codebase context into a structured PRD in Markdown.",
  "entrypoint": "SKILL.md",
  "runtime": "instruction_only",
  "inputs": {
    "conversation_context": {
      "type": "text",
      "required": true,
      "description": "User goal, prior discussion, or decision context."
    },
    "codebase_context": {
      "type": "directory_or_files",
      "required": false,
      "description": "Relevant repository context when the PRD depends on existing implementation."
    },
    "output": {
      "type": "string",
      "required": false,
      "description": "Optional output path for the generated PRD markdown."
    }
  },
  "outputs": {
    "prd": {
      "type": "markdown"
    }
  },
  "permissions": {
    "filesystem_read": true,
    "filesystem_write": true,
    "network": false
  },
  "safety": {
    "handles_sensitive_data": false,
    "requires_user_confirmation": true,
    "destructive": false,
    "stop_conditions": [
      "授權、資料來源、範圍、身份或外部操作權限無法確認時停止高影響部分。",
      "發現來源矛盾、敏感資料暴露、輸出無法驗證或任務目標漂移時停止並要求人工判斷。"
    ],
    "approval_scope": [
      "exact_action",
      "exact_target",
      "exact_diff",
      "rollback_or_recovery_plan"
    ],
    "audit_requirements": [
      "record_sources",
      "record_assumptions",
      "record_approval_before_write"
    ],
    "rollback_required": false,
    "dry_run_default": true,
    "data_minimization": "redact_by_default",
    "approval_reason": "PRD 可能影響產品範圍、工程承諾與資源配置；輸出前需確認假設與決策邊界。",
    "rules": [
      "不得捏造事實、資料、來源、同意或驗證結果。",
      "外部服務採唯讀或草稿模式；寫入、發佈、部署與不可逆操作前必須取得明確人工批准。",
      "對敏感資料採資料最小化、遮罩與最短保留原則。"
    ]
  },
  "risk_level": "low",
  "source": {
    "local_path": "~/.skills/to-prd/SKILL.md",
    "status": "imported_local"
  },
  "schema_version": "1.1.0",
  "contract_version": "1.1.0",
  "capabilities": {
    "filesystem": "workspace_read_write",
    "network": "none",
    "shell": "none",
    "git": "none",
    "browser": "none"
  },
  "connectors": [],
  "data_egress": {
    "mode": "none",
    "connectors": [],
    "allowed_data_classes": [],
    "approval_required": false,
    "minimize_and_redact": true,
    "retention": "none_by_default"
  },
  "external_write": {
    "allowed": false,
    "mode": "draft_or_read_only",
    "approval_required": true,
    "approval_scope": []
  },
  "execution": {
    "executor": "instruction_only",
    "adapter": "SKILL.md",
    "network_is_not_implied": true
  },
  "activation": {
    "positive_examples": [
      "使用者明確要求：Turn conversation and codebase context into a structured PRD in Markdown."
    ],
    "negative_examples": [
      "任務只涉及與「To PRD」無關的主題，不需要其專門流程。"
    ],
    "exclude_when": [
      "若任務不涉及「To PRD」的核心目的、輸入或輸出，不要啟用本技能。"
    ],
    "priority": 40,
    "delegates_to": [],
    "selection_notes": "先檢查任務目的、輸入資料與外部權限；相鄰技能重疊時以最小權限與最窄範圍優先。"
  },
  "related_skills": []
}
