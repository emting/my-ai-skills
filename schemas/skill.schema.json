{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emting/my-ai-skills/blob/main/schemas/skill.schema.json",
  "title": "Agent Skill Manifest",
  "description": "Portable metadata contract for a skill in this repository.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "entrypoint",
    "runtime",
    "inputs",
    "outputs",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "minLength": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "enum": [
        "instruction_only",
        "python",
        "node",
        "shell",
        "http",
        "unknown"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ioField"
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ioField"
      }
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "activation_policy": {
      "type": "string",
      "minLength": 1
    },
    "default_config": {
      "type": "object"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "local_path": {"type": "string"},
        "status": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "ioField": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "description": {"type": "string"},
        "extensions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "properties": {
        "filesystem_read": {"type": "boolean"},
        "filesystem_write": {"type": "boolean"},
        "network": {"type": "boolean"},
        "api_key_required": {"type": "boolean"},
        "browser_automation": {"type": "boolean"},
        "third_party_processing": {"type": "boolean"},
        "shell": {"type": "boolean"},
        "git": {"type": "boolean"},
        "google_ads_read": {"type": "boolean"},
        "google_ads_write": {"type": "boolean"},
        "notion_read": {"type": "boolean"},
        "notion_write": {"type": "boolean"},
        "n8n_write": {"type": "boolean"},
        "mcp_write_tools": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "handles_sensitive_data": {"type": "boolean"},
        "requires_user_confirmation": {"type": "boolean"},
        "destructive": {"type": "boolean"},
        "rules": {
          "type": "array",
          "items": {"type": "string"}
        },
        "disallowed_uses": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_without_explicit_approval": {
          "type": "array",
          "items": {"type": "string"}
        },
        "always_forbidden": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
